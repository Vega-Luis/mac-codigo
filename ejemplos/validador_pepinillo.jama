hambriento #Inicio del programa #
cocinar:
    tomate palabra <- "MacCodigo",
    torta longitud <- 9,
    torta vocales <- 0,
    torta consonantes <- 0,
    pepinillo letra <- 'a',
    torta i <- 0,
    
    servir("Analizando la palabra: "; palabra),
    
    para i hasta longitud:
        letra <- palabra!!i,
        ¿si? letra = 'a':
            vocales <- vocales + 1
        ¡de otro modo!:
            ¿si? letra = 'e':
                vocales <- vocales + 1
            ¡de otro modo!:
                ¿si? letra = 'i':
                    vocales <- vocales + 1
                ¡de otro modo!:
                    ¿si? letra = 'o':
                        vocales <- vocales + 1
                    ¡de otro modo!:
                        consonantes <- consonantes + 1.......
    
    servir("Total de vocales: "; vocales),
    servir("Total de consonantes: "; consonantes)..
satisfecho #Fin del programa #
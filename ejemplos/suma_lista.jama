hambriento #Inicio del programa #
ingrediente
    cajita de torta numeros <- [10, 20, 30, 40, 50].
cocinar:
    torta suma <- 0,
    torta i <- 0,
    
    para i hasta 5:
        suma <- suma + numeros!!i.
    
    servir("La suma total es: "; suma),
    servir("El promedio es: "; suma div 5)..
satisfecho #Fin del programa #
hambriento #Inicio del programa #
receta fibonacci(
	torta n 
) -> torta:
	¿si? n <= 1:
		entregar(n)
	¡de otro modo!:
      	entregar(fibonacci(n-1) + fibonacci(n-2)).
cocinar:
torta limite <- 6,
torta i <- 0,
para i hasta limite:
servir("Fib("; i; ") = "; fibonacci(i))..
satisfecho #Fin del programa #
